{
  "name": "salon-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm -ws run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "dev:api": "npm --workspace apps/api run dev",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace packages/data-access run migrate:dev",
    "db:generate": "npm --workspace packages/data-access run generate",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^9.6.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "@types/node": "^20.11.30",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}

